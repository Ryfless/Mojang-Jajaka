PORT=4000
APP_BASE_URL=http://localhost:4000
NODE_ENV=development

# Supabase PostgreSQL (Session Pooler URI)
DATABASE_URL=postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

# JWT
JWT_SECRET=ganti_dengan_secret_yang_kuat
JWT_EXPIRES_IN=1d

# Google reCAPTCHA
# Test secret key resmi Google (selalu lolos) untuk uji lokal/Swagger:
# 6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
RECAPTCHA_SECRET_KEY=isi_secret_key_recaptcha
RECAPTCHA_MIN_SCORE=0.5

# SMTP (Mailtrap Sandbox untuk development)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=isi_user_smtp
SMTP_PASS=isi_password_smtp
MAIL_FROM="MOKA Kabupaten Bogor <no-reply@moka.local>"

# Masa berlaku token (menit)
EMAIL_VERIFICATION_EXPIRES_MINUTES=60
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
